{
  "name": "evolution-api",
  "version": "2.4.0",
  "description": "Rest api for communication with WhatsApp",
  "main": "./dist/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "start": "tsx ./src/main.ts",
    "start:prod": "node dist/main",
    "dev:server": "tsx watch ./src/main.ts",
    "test": "tsx watch ./test/all.test.ts",
    "lint": "eslint --fix src",
    "lint:check": "eslint src",
    "commit": "cz",
    "commitlint": "commitlint --edit",
    "db:generate": "node runWithProvider.js \"npx prisma generate --schema ./prisma/DATABASE_PROVIDER-schema.prisma\"",
    "db:deploy": "node runWithProvider.js \"rm -rf ./prisma/migrations && cp -r ./prisma/DATABASE_PROVIDER-migrations ./prisma/migrations && npx prisma migrate deploy --schema ./prisma/DATABASE_PROVIDER-schema.prisma\"",
    "db:deploy:win": "node runWithProvider.js \"xcopy /E /I prisma\\DATABASE_PROVIDER-migrations prisma\\migrations && npx prisma migrate deploy --schema prisma\\DATABASE_PROVIDER-schema.prisma\"",
    "db:studio": "node runWithProvider.js \"npx prisma studio --schema ./prisma/DATABASE_PROVIDER-schema.prisma\"",
    "db:migrate:dev": "node runWithProvider.js \"rm -rf ./prisma/migrations && cp -r ./prisma/DATABASE_PROVIDER-migrations ./prisma/migrations && npx prisma migrate dev --schema ./prisma/DATABASE_PROVIDER-schema.prisma && cp -r ./prisma/migrations/* ./prisma/DATABASE_PROVIDER-migrations\"",
    "db:migrate:dev:win": "node runWithProvider.js \"xcopy /E /I prisma\\DATABASE_PROVIDER-migrations prisma\\migrations && npx prisma migrate dev --schema prisma\\DATABASE_PROVIDER-schema.prisma\"",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EvolutionAPI/evolution-api.git"
  },
  "keywords": [
    "chat",
    "communication",
    "message",
    "send message",
    "whatsapp",
    "js-whatsapp",
    "whatsapp-api",
    "whatsapp-web",
    "whatsapp",
    "whatsapp-chat",
    "whatsapp-group",
    "automation",
    "multi-device",
    "bot"
  ],
  "author": {
    "name": "Davidson Gomes",
    "email": "contato@evolution-api.com"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/EvolutionAPI/evolution-api/issues"
  },
  "homepage": "https://github.com/EvolutionAPI/evolution-api#readme",
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "eslint --fix"
    ],
    "src/**/*.ts": [
      "sh -c 'tsc --noEmit'"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@adiwajshing/keyed-db": "^0.2.4",
    "@aws-sdk/client-sqs": "^3.1115.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@figuro/chatwoot-sdk": "^1.1.17",
    "@hapi/boom": "^10.0.1",
    "@nats-io/nats-core": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/node": "^10.70.0",
    "amqplib": "^2.0.1",
    "audio-decode": "^3.12.0",
    "axios": "^1.19.0",
    "baileys": "7.0.0-rc14",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "emoji-regex": "^10.6.0",
    "eventemitter2": "^6.4.9",
    "express": "^5.2.1",
    "fetch-socks": "^1.3.3",
    "form-data": "^4.0.6",
    "https-proxy-agent": "^9.1.0",
    "i18next": "^26.4.0",
    "jimp": "^1.6.1",
    "json-schema": "^0.4.0",
    "jsonschema": "^1.5.0",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "libphonenumber-js": "^1.13.12",
    "link-preview-js": "^5.0.0",
    "long": "^5.3.2",
    "mediainfo.js": "^0.3.7",
    "mime": "^4.1.0",
    "mime-types": "^3.0.2",
    "minio": "^8.0.7",
    "multer": "^2.2.0",
    "node-cache": "^5.1.2",
    "node-cron": "^4.6.0",
    "openai": "^7.5.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prisma": "^7.9.1",
    "pusher": "^5.3.4",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "redis": "^6.2.1",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "socks-proxy-agent": "^10.1.0",
    "swagger-ui-express": "^5.0.1",
    "tsup": "^8.5.1",
    "undici": "^8.10.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/json-schema": "^7.0.15",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.67.0"
  }
}
